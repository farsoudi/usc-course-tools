# Copy this file to .env and set COURSE_TOOLS_DATA_DIR to where course-tools
# should keep auth.json and its persistent browser profile. .env is gitignored.
#
# Linux:   ~/.local/share/course-tools
# macOS:   ~/Library/Application Support/course-tools
# Windows: %LOCALAPPDATA%\course-tools
#
# Leave blank to use the platform default.
COURSE_TOOLS_DATA_DIR=

# auto (default), chrome, edge, or chromium
COURSE_TOOLS_BROWSER=auto
